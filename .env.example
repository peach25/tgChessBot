# Обязательно: токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Обязательно: ваш числовой telegram user id (узнать: написать @userinfobot)
ADMIN_TELEGRAM_ID=

# Необязательные настройки (значения по умолчанию)
# DB_PATH=data/bot.db
# LOG_FILE=logs/bot.log
# LOG_LEVEL=INFO
# CHESSCOM_USER_AGENT=chess-tgbot/1.0 (contact: you@example.com)
# HTTP_TIMEOUT=15
# Часовой пояс для времени в сообщениях (по умолчанию московское)
# TIMEZONE=Europe/Moscow
# CHECK_INTERVAL_SECONDS=300
# MAX_GAMES_PER_CHECK=5

# Stockfish (по умолчанию ищется stockfish в PATH, затем /usr/games/stockfish)
# STOCKFISH_PATH=/usr/games/stockfish
# STOCKFISH_DEPTH=14
# STOCKFISH_THREADS=1
# STOCKFISH_HASH_MB=64
# Искать «единственные ходы» (анализ ~в 3 раза дольше); 0 — выключить
# STOCKFISH_FIND_ONLY_MOVES=1
# STOCKFISH_MOVE_TIME_LIMIT=3
# STOCKFISH_GAME_TIMEOUT=300
# STOCKFISH_START_TIMEOUT=15
